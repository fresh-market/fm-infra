#!/bin/bash
#
# SSM 에서 값을 읽어 관측 스택의 .env 와 웹훅 파일을 다시 만든다.
#
# 최초 부팅과 이후 갱신이 같은 코드를 쓴다 (MNT-3-01).
# user-data 는 최초 부팅에만 돌아서, 이 스크립트가 없으면 RDS 복원으로 주소가 바뀌어도
# 익스포터가 옛 주소로 붙으려 한다. 인스턴스는 살아 있으므로 monitoring-status 알람도 안 울린다.
# DB 와 캐시 지표가 조용히 사라진다 (INF-26).
set -euo pipefail

P=/${project}
R=${region}
D=/opt/${project}/infra/observability

get() { aws ssm get-parameter --name "$P/$1" --region "$R" --query 'Parameter.Value' --output text; }
sec() { aws ssm get-parameter --name "$P/$1" --region "$R" --with-decryption --query 'Parameter.Value' --output text; }

# 웹훅 URL 은 사실상 자격증명이다. 파일로 떨어뜨려 Alertmanager 가 읽게 한다.
#
# 소유자를 65534(nobody)로 맞춘다. prom/alertmanager 가 그 사용자로 돌기 때문이다.
# root:root 0600 으로 두면 컨테이너가 permission denied 로 읽지 못하고,
# Alertmanager 는 그때 알람을 버리면서 자기 로그에만 남긴다.
# 알람이 안 오는 것으로만 드러나는 고장이라 Slack 이 조용한 것이 정상인지 구분되지 않는다.
#
# 0600 은 유지한다. 소유자만 바뀌고 다른 사용자에게는 그대로 닫혀 있다.
# 디렉터리도 같은 이유로 소유자를 맞춘다. 0700 이라 소유자가 아니면 들어가지 못한다.
ALERTMANAGER_UID=65534
install -d -m 0700 -o "$ALERTMANAGER_UID" -g "$ALERTMANAGER_UID" /run/secrets
for name in critical warning watchdog; do
  f="/run/secrets/slack_webhook_$name"
  sec "slack-webhook-$name" > "$f"
  chown "$ALERTMANAGER_UID:$ALERTMANAGER_UID" "$f"
  chmod 600 "$f"
done

# Grafana 가 자기 주소를 아는 값이다. 없으면 SSM 포트 포워딩으로 보므로 localhost 가 맞다.
GRAFANA_ROOT_URL=$(get grafana-root-url)
[ "$GRAFANA_ROOT_URL" = "unset" ] && GRAFANA_ROOT_URL=http://localhost:3000/

# 주소가 있다고 인증 프록시를 켜면 안 된다.
# 헤더를 실어 주는 것은 ALB 의 OIDC 리스너뿐이라 그 조건만 따른다.
# DuckDNS 경로에는 ALB 가 없어 켜 두면 아무도 로그인하지 못한다.
GRAFANA_AUTH_PROXY_ENABLED=$(get grafana-auth-proxy)

# 아직 안 넣었을 수 있으므로 없으면 빈 값으로 둔다.
GRAFANA_ADMIN_PASSWORD=$(sec grafana-admin-password 2>/dev/null || true)
[ "$GRAFANA_ADMIN_PASSWORD" = "unset" ] && GRAFANA_ADMIN_PASSWORD=""

CADDY_BASIC_AUTH_HASH=$(sec caddy-basic-auth-hash 2>/dev/null || true)
[ "$CADDY_BASIC_AUTH_HASH" = "unset" ] && CADDY_BASIC_AUTH_HASH=""

# Caddy 는 호스트명이 있을 때만 띄운다. compose 의 tls 프로필이 그것을 받는다.
DUCKDNS_HOSTNAME=$(get duckdns-hostname)
COMPOSE_PROFILES=
if [ "$DUCKDNS_HOSTNAME" = "unset" ]; then
  DUCKDNS_HOSTNAME=""
else
  COMPOSE_PROFILES=tls

  # 인증 없이 인터넷에 열리는 것을 막는다. 둘 중 하나라도 비면 여기서 멈춘다.
  if [ -z "$CADDY_BASIC_AUTH_HASH" ]; then
    echo "caddy-basic-auth-hash 가 비어 있다. 인증 없이 Grafana 를 열 수 없다." >&2
    echo "  docker run --rm caddy caddy hash-password --plaintext '<비밀번호>'" >&2
    exit 1
  fi
  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    echo "grafana-admin-password 가 비어 있다. 기본 비밀번호로 밖에 열 수 없다." >&2
    exit 1
  fi
fi

install -d -m 0755 "$D"
cat > "$D/.env" <<ENV
DB_ENDPOINT=$(get db-endpoint)
CACHE_ENDPOINT=$(get cache-endpoint)
DB_EXPORTER_PASSWORD=$(sec db-exporter-password)
DB_EXPORTER_USER=${db_username}
GRAFANA_ROOT_URL=$GRAFANA_ROOT_URL
GRAFANA_AUTH_PROXY_ENABLED=$GRAFANA_AUTH_PROXY_ENABLED
GRAFANA_ADMIN_PASSWORD=$GRAFANA_ADMIN_PASSWORD
DUCKDNS_HOSTNAME=$DUCKDNS_HOSTNAME
CADDY_BASIC_AUTH_HASH=$CADDY_BASIC_AUTH_HASH
COMPOSE_PROFILES=$COMPOSE_PROFILES
ENV
chmod 600 "$D/.env"

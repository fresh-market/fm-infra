services:
  app:
    image: ${app_image}:$${GIT_SHA}
    container_name: ${project}
    # always 가 아니다. 운영자가 멈춘 것을 되살리면 장애 주입 시험이 성립하지 않는다.
    restart: unless-stopped
    ports:
      - "8080:8080"
      - "8081:8081"
    volumes:
      # 힙 덤프를 호스트에 남긴다. 아래 HeapDumpPath 와 같은 자리다
      - /opt/${project}/dumps:/dumps
    environment:
      SPRING_PROFILES_ACTIVE: "${profiles}"
      #
      # 어디에 붙는지만 준다. 드라이버 옵션은 백엔드의 data-source-properties 가 갖는다.
      #
      # 전에는 이 URL 에 connectTimeout 과 socketTimeout 을 붙여 두었는데, 그 값이
      # application-coupon.yml 의 data-source-properties(250/250)와 충돌하고 있었다.
      # 어느 쪽이 이기는지 실측한 적이 없어 운영 값이 무엇인지 아무도 확신하지 못했다.
      #
      # rewriteBatchedStatements 도 여기 있었다. 원래 application.yml 의 url 기본값에
      # 적혀 있었지만 ${"$"}{DB_URL:...} 문법이라 이 환경 변수가 있으면 버려진다.
      # 그래서 운영에는 적용된 적이 없었고 로컬에서만 되는 모양이었다 (2026-08-30).
      #
      # 둘 다 백엔드로 옮겼다. 인프라는 엔드포인트만 소유한다.
      #
      DB_URL: "jdbc:mysql://$${DB_ENDPOINT}:3306/${db_name}"
      DB_USERNAME: "${db_username}"
      DB_PASSWORD: "$${DB_PASSWORD}"
      # 앱이 기본값 없이 요구하는 값들이다. 빠지면 @Value 가 기동을 막는다.
      # 값은 SSM 시크릿에서 refresh-env 를 거쳐 .env 로 들어온다.
      JWT_SECRET: "$${JWT_SECRET}"
      KAKAO_CLIENT_ID: "$${KAKAO_CLIENT_ID}"
      KAKAO_CLIENT_SECRET: "$${KAKAO_CLIENT_SECRET}"
      KAKAO_APP_ID: "$${KAKAO_APP_ID}"
      KAKAO_ADMIN_KEY: "$${KAKAO_ADMIN_KEY}"
      # 결제 모듈이 기본값 없이 요구한다. 앱 주석이 "기동 시점에 바로 실패해야 한다" 고 적었다.
      #
      # 2026-10-11 에 결제 모듈이 develop 에 들어왔는데 이 인프라가 그 환경변수를 안 따라갔다.
      # 2026-10-13 에 develop 기반으로 인프라를 세우니 앱이 전부 기동 실패하고 ASG 가 계속
      # 교체했다. 대상 그룹은 Target.FailedHealthChecks 만 보여 원인이 안 드러났다.
      TOSS_SECRET_KEY: "$${TOSS_SECRET_KEY}"
      # 이름을 앱에 맞춘다. 앱은 로컬 compose 와 같은 변수를 써야 해서 VALKEY_HOST 로 정했다.
      # 값은 SSM cache-endpoint 에서 온다. 복원으로 주소가 바뀌면 refresh-env 가 따라잡는다.
      VALKEY_HOST: "$${CACHE_ENDPOINT}"
      VALKEY_PORT: "6379"
      # 앱의 cdn.base-url 이 이 값을 읽는다 (fm-backend #66).
      # 이미지 URL 앞에 붙는 주소이고, 이름을 그 설정 키에 맞춰 두었다.
      CDN_BASE_URL: "https://$${CDN_DOMAIN}"
      APP_NAME: "${project}"
      APP_INSTANCE_ID: "$${APP_INSTANCE_ID}"
      TRACE_SAMPLE_RATE: "0.1"
      #
      # MaxRAMPercentage 는 컨테이너 한도 기준이다. 그래서 아래 mem_limit 과 짝이다.
      #
      # 한도가 없던 동안 이 70% 가 호스트 전체의 70% 로 잡혀 힙이 1,333MB 까지 자랐고,
      # 복합 장애 회차 세 번이 커널 OOM 에 덮였다. 한도를 지우면 그 상태로 돌아간다.
      #
      # DNS TTL 이 결정적이다. 이것이 빠지면 페일오버 후 옛 주소를 계속 찾는다.
      #
      # 한도 1,200 MiB 안에서 힙과 다이렉트를 둘 다 묶는다.
      #
      # 묶어야 하는 까닭은 MaxDirectMemorySize 의 기본값이 최대 힙이라서다. 힙만 70% 로
      # 묶으면 840 + 840 이 되어 한도를 넘고, 그때는 cgroup 이 컨테이너를 죽인다. 비율을
      # 60 으로 내린 것도 같은 까닭이다. MaxRAMPercentage 는 힙만 재고 나머지는 안 센다.
      #
      #   힙             720 MiB   MaxRAMPercentage=60
      #   다이렉트       128 MiB   MaxDirectMemorySize. Netty 가 쓰는 자리다
      #   메타스페이스   ~100 MiB
      #   코드 캐시       ~64 MiB
      #   스레드 스택     ~48 MiB
      #   JVM 내부       ~80 MiB
      #   합계         ~1,140 MiB  <  1,200
      #
      # 다이렉트를 묶는 두 번째 값어치는 터지는 자리가 드러나는 것이다. 안 묶으면 그 증가가
      # RSS 로만 보이고 jvm_memory_used_bytes 에는 안 잡힌다. 2026-10-01 F-2 가 그 모양이었다.
      # 힙 used 합계가 1.2 GiB 안팎인데 anon-rss 가 1.4GB 였다. 묶으면 그 자리에서
      # "OutOfMemoryError: Direct buffer memory" 가 난다.
      #
      # 힙이 마르면 덤프를 남기고 죽는다. 한도와 짝이라 여기 있다.
      #
      # 한도가 없던 동안에는 호스트가 먼저 말라 커널이 자바를 골랐고, 그래서 터진 까닭이
      # 아무 데도 안 남았다 (rebuild-reconnect-and-fault-2026-10-01.md 4장이 "지금은 왜
      # 말랐는지가 안 남는다" 로 적은 자리다). 한도를 걸면 힙이 먼저 마르므로 OutOfMemoryError
      # 가 나는데, 그것만으로 덤프가 생기지는 않는다. 이 플래그가 있어야 생긴다.
      #
      # ExitOnOutOfMemoryError 를 함께 준다. OOME 를 삼키고 반쯤 살아 있는 앱이 헬스체크를
      # 통과하면 ALB 가 계속 요청을 보낸다. 죽으면 위 restart 가 되살린다.
      #
      JAVA_TOOL_OPTIONS: >-
        -XX:MaxRAMPercentage=60
        -XX:MaxDirectMemorySize=128m
        -XX:+HeapDumpOnOutOfMemoryError
        -XX:HeapDumpPath=/dumps
        -XX:+ExitOnOutOfMemoryError
        -Dnetworkaddress.cache.ttl=5
        -Dnetworkaddress.cache.negative.ttl=1
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/actuator/health/liveness"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 60s
    #
    # 예산은 variables.tf 의 container_mem_limits 가 갖는다.
    #
    # 이 한도가 터지면 cgroup 이 이 컨테이너만 죽이고 위 restart 가 되살린다. 커널이
    # 호스트에서 아무 프로세스나 고르던 것과 다른 점이 그것이고, cAdvisor 가
    # container_oom_events_total 로 기록하므로 회차 뒤에 누가 터졌는지 알 수 있다.
    #
    mem_limit: ${mem_limit_app}
    # 종료 타임아웃 계층. Spring graceful 30초보다 길고 systemd 60초보다 짧다.
    stop_grace_period: 45s
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  #
  # 관측 셋에도 한도를 건다. 안 걸면 예산이 이름만 예산이다.
  #
  # 앱만 한도를 걸면 이 셋이 자라서 호스트가 마르고, 그때 커널이 고르는 쪽은 다시 앱이다.
  # 앱 한도 안에서 죽는 것과 호스트가 말라 죽는 것을 가르려면 넷을 다 묶어야 한다.
  #
  # 호스트 지표. CPU 크레딧이 여기서 나온다. 모니터링이 9100 으로 긁는다.
  node-exporter:
    image: prom/node-exporter:v1.9.1
    container_name: node-exporter
    restart: unless-stopped
    pid: host
    ports:
      - "9100:9100"
    volumes:
      - /:/host:ro,rslave
    command:
      - --path.rootfs=/host
    mem_limit: ${mem_limit_node_exporter}

  # 컨테이너 지표. OOM 감지가 여기서 나온다.
  # 기본 포트가 8080 이라 앱과 겹친다. 8082 로 옮긴다.
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.55.1
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    ports:
      - "8082:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    mem_limit: ${mem_limit_cadvisor}

  # 컨테이너 로그를 Loki 로 민다. Loki 는 모니터링 인스턴스에 있다.
  alloy:
    image: grafana/alloy:v1.12.1
    container_name: alloy
    restart: unless-stopped
    volumes:
      - ./alloy-config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      INSTANCE_ROLE: "${role}"
      GIT_SHA: "$${GIT_SHA}"
      LOKI_ENDPOINT: "$${LOKI_ENDPOINT}"
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - /etc/alloy/config.alloy
    mem_limit: ${mem_limit_alloy}

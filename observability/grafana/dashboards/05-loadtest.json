  {
   "type": "timeseries",
   "title": "도착률과 VU",
   "description": "k6 가 실제로 보낸 초당 요청 수다. 계획한 도착률과 다르면 생성기가 못 따라간 것이다.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",

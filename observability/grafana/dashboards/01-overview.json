          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ALB 응답시간",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",

    {
      "type": "timeseries",
      "title": "ALB 5xx",
      "description": "앱이 아니라 ALB 가 만든 5xx 다. 앱 지표에는 안 잡힌다.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
